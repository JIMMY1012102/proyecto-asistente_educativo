# Configuración del Asistente de Retroalimentación para Simulacros CNI
# Copiar este archivo a .env y completar con los valores reales

# =============================================================================
# CONFIGURACIÓN DEL ENTORNO
# =============================================================================
# Valores: development, testing, production
ENVIRONMENT=development

# =============================================================================
# GEMINI API - OBLIGATORIO (Requisito 10.2)
# =============================================================================
# Obtener en: https://makersuite.google.com/app/apikey
# NUNCA incluir la clave real en el código fuente
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_SECONDS=8

# =============================================================================
# CONFIGURACIÓN JWT
# =============================================================================
# Clave secreta para firmar tokens JWT (mínimo 32 caracteres en producción)
JWT_SECRET_KEY=your_secret_key_here_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =============================================================================
DATABASE_PATH=./data/asistente_cni.db

# =============================================================================
# SERVIDOR MCP (Semana 4 - Requisito 11.2)
# =============================================================================
# Configuración del servidor MCP de solo lectura
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_TIMEOUT_SECONDS=10
# OBLIGATORIO: Servidor en modo solo lectura
MCP_READ_ONLY=true

# =============================================================================
# CONFIGURACIÓN DE LOGGING (Requisito 11.3)
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/asistente_cni.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# CONFIGURACIÓN DE FASTAPI
# =============================================================================
APP_NAME=Asistente CNI
APP_VERSION=1.0.0
DEBUG_MODE=false
HOST=127.0.0.1
PORT=8000

# =============================================================================
# CONFIGURACIÓN DE CORS
# =============================================================================
# Lista de orígenes permitidos separados por comas
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=*

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================
# Timeout de sesión en horas (Requisito 1.4)
SESSION_TIMEOUT_HOURS=8
# Máximo número de intentos de login
MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# CONFIGURACIONES ESPECÍFICAS POR ENTORNO
# =============================================================================

# Para entorno de desarrollo:
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Para entorno de testing:
# ENVIRONMENT=testing
# DATABASE_PATH=:memory:
# LOG_LEVEL=WARNING
# MCP_SERVER_PORT=9999

# Para entorno de producción:
# ENVIRONMENT=production
# DEBUG_MODE=false
# LOG_LEVEL=INFO
# Asegurar que JWT_SECRET_KEY y GEMINI_API_KEY son seguros